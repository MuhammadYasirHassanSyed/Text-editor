
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Text Editor",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-Wall",
                "-Iinclude",
                "src/main.cpp",
                "src/LineBuffer.cpp",
                "-o",
                "text_editor"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
